# Railway environment variables template
# Load with: ./env-setup.sh --from-file .env.railway

# Application
SECRET_KEY=your-secure-secret-key
APP_NAME="Litestar Fullstack SPA"
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
LITESTAR_DEBUG=false
LITESTAR_PORT=${{PORT}}
LITESTAR_TRUSTED_PROXIES=*
VITE_DEV_MODE=false
COOKIE_SECURE=true
REGISTRATION_REQUIRE_VERIFICATION=true

# Database (private network URL avoids public egress charges)
DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
DATABASE_POOL_SIZE=5
DATABASE_MAX_POOL_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# PostgreSQL Queues (litestar-queues)
# Single-service default embeds the worker in the ASGI lifespan (no extra worker container).
# Set QUEUES_PLACEMENT=external only when scaling out with railway.worker.json.
QUEUES_PLACEMENT=asgi
QUEUES_MAX_CONCURRENCY=8
QUEUES_TERMINAL_RETENTION_SECONDS=604800

# Email (Resend)
EMAIL_BACKEND=console
# EMAIL_BACKEND=resend
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com
# EMAIL_FROM_NAME="Litestar Fullstack SPA"
# RESEND_API_KEY=re_xxxxxxxxxxxx

# GitHub OAuth (Optional)
# Callback URL: https://${{RAILWAY_PUBLIC_DOMAIN}}/api/auth/oauth/github/callback
# GITHUB_OAUTH2_CLIENT_ID=your-github-client-id
# GITHUB_OAUTH2_CLIENT_SECRET=your-github-client-secret

# Logging
LOG_LEVEL=20
SQLALCHEMY_LOG_LEVEL=30
