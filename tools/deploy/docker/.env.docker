# App
SECRET_KEY='secret-key-for-local-docker-development-only'
LITESTAR_DEBUG=true
LITESTAR_HOST=0.0.0.0
LITESTAR_PORT=8000
APP_URL=http://localhost:${LITESTAR_PORT}
LITESTAR_TRUSTED_PROXIES=*

LOG_LEVEL=20
# Database (asyncpg)
DATABASE_ECHO=false
DATABASE_ECHO_POOL=false
DATABASE_POOL_DISABLED=false
DATABASE_MAX_POOL_OVERFLOW=5
DATABASE_POOL_SIZE=5
DATABASE_POOL_TIMEOUT=30
DATABASE_USER=app
DATABASE_PASSWORD=app
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_DB=app
DATABASE_URL=postgresql+asyncpg://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_DB}

# PostgreSQL Queue Worker (litestar-queues)
QUEUES_MAX_CONCURRENCY=10
QUEUES_POLL_INTERVAL=1.0
QUEUES_PLACEMENT=external

VITE_DEV_MODE=false
VITE_PORT=3006
ALLOWED_CORS_ORIGINS=["http://localhost:3006","http://localhost:8000"]
