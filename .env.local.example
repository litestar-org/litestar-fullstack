# App Configuration
SECRET_KEY='your-32-byte-or-longer-secret-key-here'
LITESTAR_DEBUG=true
LITESTAR_HOST=0.0.0.0
LITESTAR_PORT=8000
APP_URL=http://localhost:8000
LOG_LEVEL=20

# Database Configuration (asyncpg)
DATABASE_ECHO=false
DATABASE_ECHO_POOL=false
DATABASE_POOL_DISABLED=false
DATABASE_MAX_POOL_OVERFLOW=10
DATABASE_POOL_SIZE=5
DATABASE_POOL_TIMEOUT=30
DATABASE_USER=app
DATABASE_PASSWORD=app
DATABASE_HOST=localhost
DATABASE_PORT=15432
DATABASE_DB=app
DATABASE_URL=postgresql+asyncpg://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_DB}

# PostgreSQL Queue Configuration (litestar-queues)
QUEUES_MAX_CONCURRENCY=10
QUEUES_POLL_INTERVAL=1.0
QUEUES_PLACEMENT=asgi

# Frontend Configuration
VITE_DEV_MODE=true
VITE_PORT=3006
ALLOWED_CORS_ORIGINS=["http://localhost:3006","http://localhost:8000"]

# Proxy Configuration (for production behind reverse proxy)
# Trust X-Forwarded-* headers for correct HTTPS detection in OAuth redirects
# Use "*" to trust all proxies (safe for Railway/Docker), or specific IPs
# LITESTAR_TRUSTED_PROXIES=*

# Email Configuration (SMTP / Mailpit)
EMAIL_BACKEND=smtp
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=11025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_FROM_ADDRESS=noreply@localhost
EMAIL_FROM_NAME="Litestar Dev App"
EMAIL_TIMEOUT=30

# OAuth Configuration (Optional)
# GitHub callback: http://localhost:8000/api/auth/oauth/github/callback
# GITHUB_OAUTH2_CLIENT_ID=
# GITHUB_OAUTH2_CLIENT_SECRET=

# Storage Configuration (RustFS - S3 Compatible)
# Access RustFS console at: http://localhost:19001
# S3 API endpoint: http://localhost:19000
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=app
# AWS_SECRET_ACCESS_KEY=app
# AWS_ENDPOINT_URL=http://localhost:19000
# STORAGE_BUCKET=uploads

# Mailpit (Development Email Testing)
# Web UI: http://localhost:18025 | SMTP: localhost:11025
